# PostgreSQL database. Only this URL is read.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskdesk"

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change_me_to_a_long_random_string"

# Key that encrypts tool and credential passwords: 32 random bytes in base64. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up separately from the database. Without it, saved passwords cannot be read.
CREDENTIALS_KEY=""

# Secret for the daily job endpoint (/api/cron/generate)
CRON_SECRET="change_me_too"

# Team time zone. Decides what "today" means for due dates, attendance and recurring tasks.
APP_TIMEZONE="Asia/Kolkata"

# How many days ahead recurring tasks are created, so people can plan the week
GENERATION_LOOKAHEAD_DAYS="7"

# First admin account created by "npm run seed". The admin is asked to change this password at first sign in.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@searchengineers.in"
ADMIN_PASSWORD="ChangeMe@123"

# Set to "true" to also load demo people, clients, projects and history when seeding (password Demo@1234).
# Never on your live server.
SEED_DEMO="false"

# Set to "true" when served over HTTPS so the login cookie is marked secure
COOKIE_SECURE="false"
