{
  "name": "taskdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Task management for the Search Engineers team: recurring and one time tasks, Kanban board, projects, attendance, leave, clients and reports.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "daily": "tsx scripts/daily.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx prisma/seed.ts --demo"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "next": "15.5.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
